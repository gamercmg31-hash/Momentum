# Supabase-only configuration.
# Copy both values from Supabase Dashboard → Connect.
# In Vercel, add them to Development, Preview, and Production, then redeploy.
#
# IMPORTANT: The URL is the Project URL (https://<project-ref>.supabase.co),
# not your Vercel URL and not a supabase.com dashboard URL.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# New Supabase projects may provide a publishable key instead. It is supported
# as an alternative when NEXT_PUBLIC_SUPABASE_ANON_KEY is not set:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<your-publishable-key>
