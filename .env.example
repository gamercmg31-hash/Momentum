# ---------------------------------------------------------------------------
# Momentum — configuration
# ---------------------------------------------------------------------------
# PRIMARY (recommended): Supabase.
# Dashboard → Project Settings → API.
# Only the publishable / anon key is ever used — never the service-role key.
#
# As soon as BOTH variables below are set, Momentum uses Supabase for storage
# and identity and ignores DATABASE_URL completely.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-publishable-anon-key>

# FALLBACK: bundled PostgreSQL.
# If the two Supabase variables above are missing, Momentum runs on this
# database instead, using the exact same tables, columns and privacy rules.
# The schema is created automatically on first boot — nothing to run by hand.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
